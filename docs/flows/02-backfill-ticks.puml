@startuml 02-backfill-ticks
title Geonera Ingestion — 2. Backfill Ticks (Master Bulk-Claim)
skinparam backgroundColor #FFFFFF
skinparam defaultFontColor #1B1B1B
skinparam ArrowColor #546E7A
skinparam ArrowFontColor #37474F

skinparam activity {
  BackgroundColor #FAFAFA
  BorderColor #546E7A
  FontColor #1B1B1B
  FontSize 13

  BackgroundColor<<lock>> #EF6C00
  FontColor<<lock>> #FFFFFF
  BorderColor<<lock>> #A34B00

  BackgroundColor<<db>> #1565C0
  FontColor<<db>> #FFFFFF
  BorderColor<<db>> #0B3C78

  BackgroundColor<<r2>> #2E7D32
  FontColor<<r2>> #FFFFFF
  BorderColor<<r2>> #1B5E20

  BackgroundColor<<api>> #AD1457
  FontColor<<api>> #FFFFFF
  BorderColor<<api>> #6A0F38
}

skinparam activityDiamond {
  BackgroundColor #FFF3CD
  BorderColor #C79100
  FontColor #5D4037
}

skinparam legend {
  BackgroundColor #FFFFFF
  BorderColor #90A4AE
  FontColor #1B1B1B
  FontSize 12
  EntrySeparatorColor #CFD8DC
}

skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #C9A227
  FontColor #3E3E3E
}

legend right
  |= Tag |= Meaning |
  |<back:#EF6C00><color:#FFFFFF> lock </color></back>| Advisory-lock / Parent Handler step |
  |<back:#1565C0><color:#FFFFFF> db </color></back>| PostgreSQL transaction (state / outbox) |
  |<back:#2E7D32><color:#FFFFFF> r2 </color></back>| Cloudflare R2 storage I/O |
  |<back:#AD1457><color:#FFFFFF> api </color></back>| External Dukascopy API call |
endlegend

start
:runTickParentHandler(ctx, "BACKFILL", dal);<<lock>>
note right
  Triggered by queue jobs.ticks.backfill.
  Mutually exclusive with Ticks Regular — both share LockIDTick (1001).
  Instrument filter for all operations: IsActive=true & IsPause=false.
  Download is globally capped at **12** concurrent goroutines
  (rate gate + semaphore — shared across all groups in a batch).
end note

' ── Phase A: fast bulk orphan reset ──────────────────────────────────────────
' ── Master Bulk-Claim (single pass) ──────────────────────────────────────────

  :Master Bulk-Claim — single FOR UPDATE SKIP LOCKED transaction
  Claim up to **120** rows
  Status IN (PENDING, PROCESSED, FAILED, BROKEN, COMPLETED, NOT_FOUND, **ABANDONED**)
  Timestamp <= NOW() truncated to hour − 3h  **(Zona Eksklusif)**
  Sort: **non-ABANDONED first** (status-priority), then Timestamp ASC (oldest first)
  Routing layer decided atomically inside this transaction;<<db>>
  note right
    One-shot per trigger — no loop.
    The 3-hour exclusion zone ensures Backfill never
    touches rows that T-0 / T-1 / T-2 Regular are
    actively processing.
    ABANDONED rows occupy the tail of the sort — they
    only appear when no other actionable rows exist
    within the T-3 boundary.
    Each row's claim transition (PreviousStatus + Status)
    AND dispatch layer are determined at claim time —
    no second query needed after commit.
  end note

  split
    ' ── Group 1 — Main Ingestion ────────────────────────────────
    :**Group 1 — Main Ingestion**
    Rows with original status: **PENDING**
    (like T-0, but without the seed step);
    note right
      Claim transaction (above) already
      transitioned: PENDING → PROCESSED.
    end note
    :Download raw BI5 file from Dukascopy API;<<api>>
    note right: Rate gate + Semaphore — hard cap **12** concurrent

    if (Download result?) then (2xx — data received)
      :Reset NotFoundStreak = 0 (if non-zero);<<db>>
      :Convert BI5 → Parquet (Decimal/BigInt,\nusing Instrument.Divider);
      :Upload to Cloudflare R2;<<r2>>
      :Status → COMPLETED;
    elseif () then (404 — no data at source)
      :AddNotFoundStreak(+1);<<db>>
      note right
        Unlike T-0 (always streak = 0 → set to 1),
        Backfill PENDING may have streak > 0
        (reclaimed from NOT_FOUND path) — must use +1.
      end note
      :Status → NOT_FOUND;
    else (non-2xx / non-404 error)
      :Status → FAILED;
    endif

  split again
    ' ── Group 2 — Reset & Recovery ────────────────────────────────
    :**Group 2 — Reset & Recovery**
    Rows with original status: **PROCESSED**, **FAILED**, **BROKEN**,
    **NOT_FOUND** (NotFoundStreak < 3), or **ABANDONED**
    (like T-1);
    note right
      PROCESSED and ABANDONED are resolved entirely
      at claim time — set to PENDING inside the claim
      transaction, no further dispatch.
      ABANDONED also resets RetryCount = 0.
    end note

    if (Original status?) then (PROCESSED)
      :Resolved at claim time → PENDING
      (no goroutine dispatched);
    elseif () then (ABANDONED)
      :SetRetryCount = 0, Status → PENDING
      (resolved at claim time — fresh retry budget);
    elseif () then (FAILED or BROKEN)
      if (RetryCount > 5?) then (yes — budget exhausted)
        :Status → ABANDONED
        (resolved at claim time);
      else (no — retries remaining)
        :AddRetryCount(+1), SetNotFoundStreak(-1 min 0) — atomic;<<db>>
        :Status → PENDING;
        note right
          Bidirectional counter-rule: retry
          penalty reduces the not-found credit.
        end note
      endif
    else (NOT_FOUND, streak < 3)
      :Download raw BI5 file from Dukascopy API;<<api>>
      note right: Rate gate + Semaphore — same 12-slot cap
      if (Download result?) then (2xx — data now available)
        :SetNotFoundStreak = 0 — atomic;<<db>>
        :Status → PENDING (Group 1 handles ETL on next cycle);
      elseif () then (404 — still empty)
        :AddNotFoundStreak(+1)
        Set IsHoliday = true
        **DB commit BEFORE R2 upload**;<<db>>
        :Build Zero-Row Parquet in memory;
        :Upload Zero-Row Parquet to R2;<<r2>>
        :Status → NOT_FOUND;
        note right
          Group 2 tidak menjalankan validasi konsistensi parquet —
          hanya mengecek ketersediaan data (seperti T-1).
          Begitu NotFoundStreak mencapai 3, klaim berikutnya
          masuk ke Group 3 yang wajib menjalankan Physical
          Parquet Validation untuk semua kasus (COMPLETED
          maupun NOT_FOUND).
        end note
      else (non-2xx / non-404 error)
        :Status → FAILED;
      endif
    endif

  split again
    ' ── Group 3 — Final Validation ────────────────────────────────
    :**Group 3 — Final Validation (identical to T-2)**
    Rows with original status: **COMPLETED**,
    or **NOT_FOUND** (NotFoundStreak >= 3);
    :Download raw BI5 file from Dukascopy API;<<api>>
    note right: Rate gate + Semaphore — same 12-slot cap

    if (Claimed status + Download result?) then (COMPLETED + 2xx)
      note right: Re-download matches source — cross-validation
      :Reset NotFoundStreak = 0 (if non-zero);<<db>>
      :Convert BI5 → Parquet;
      :Upload (overwrite) to Cloudflare R2;<<r2>>
      :Run **Physical Parquet Validation** (criteria 6.3):
      - File existence & size > 0
      - Magic number PAR1 + footer integrity
      - Schema matching (columns, types, precision)
      - Data continuity & 1-hour boundary check;
      if (Validation result?) then (PASSED)
        :Status → CONFIRMED;
        :Insert SyncTask (outbox) in same transaction;<<db>>
      else (FAILED)
        :Status → BROKEN
        (+ demotion SyncTask if prev was CONFIRMED);<<db>>
      endif
    elseif () then (NOT_FOUND + 2xx — data now available)
      :SetNotFoundStreak = 0 — atomic;<<db>>
      :Status → PENDING (Group 1 handles ETL on next cycle);
    elseif () then (NOT_FOUND + 404 — still empty)
      :AddNotFoundStreak(+1), RetryCount(-1 min 0) — atomic;<<db>>
      if (NotFoundStreak >= 3?) then (yes — confirmed holiday)
        note right
          Zero-Row Parquet already in R2 from Group 2.
          Validate the existing file — no re-upload needed.
        end note
        :Read Zero-Row Parquet from Cloudflare R2;<<r2>>
        :Run **Physical Parquet Validation** (criteria 6.3):
        - File existence & size > 0
        - Magic number PAR1 + footer integrity
        - Schema matching (columns, types, precision)
        - Zero-row boundary check (IsHoliday=true);
        if (Validation result?) then (PASSED)
          :Status → CONFIRMED + SyncTask;<<db>>
        else (FAILED)
          :Status → BROKEN;
        endif
      else (streak < 3)
        :Status → NOT_FOUND;
      endif
    elseif () then (COMPLETED + 404 — anomaly)
      :Status → BROKEN;
      note right: Data was present at T-0 but\nis now missing — investigate manually
    else (non-2xx / non-404 error)
      :Status → FAILED;
    endif

  end split

  :Goroutines join (batchWg.Wait());

:wg.Done()
(Parent Handler releases LockIDTick);<<lock>>
stop

@enduml
