@startuml 02-backfill-ticks
title Geonera Ingestion — 2. Backfill Ticks (Sweeper, every 10 minutes)
skinparam backgroundColor #FFFFFF
skinparam defaultFontColor #1B1B1B
skinparam ArrowColor #546E7A
skinparam ArrowFontColor #37474F

skinparam activity {
  BackgroundColor #FAFAFA
  BorderColor #546E7A
  FontColor #1B1B1B
  FontSize 13

  BackgroundColor<<lock>> #EF6C00
  FontColor<<lock>> #FFFFFF
  BorderColor<<lock>> #A34B00

  BackgroundColor<<db>> #1565C0
  FontColor<<db>> #FFFFFF
  BorderColor<<db>> #0B3C78

  BackgroundColor<<r2>> #2E7D32
  FontColor<<r2>> #FFFFFF
  BorderColor<<r2>> #1B5E20

  BackgroundColor<<api>> #AD1457
  FontColor<<api>> #FFFFFF
  BorderColor<<api>> #6A0F38
}

skinparam activityDiamond {
  BackgroundColor #FFF3CD
  BorderColor #C79100
  FontColor #5D4037
}

skinparam legend {
  BackgroundColor #FFFFFF
  BorderColor #90A4AE
  FontColor #1B1B1B
  FontSize 12
  EntrySeparatorColor #CFD8DC
}

skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #C9A227
  FontColor #3E3E3E
}

legend right
  |= Tag |= Meaning |
  |<back:#EF6C00><color:#FFFFFF> lock </color></back>| Advisory-lock / Parent Handler step |
  |<back:#1565C0><color:#FFFFFF> db </color></back>| PostgreSQL transaction (state / outbox) |
  |<back:#2E7D32><color:#FFFFFF> r2 </color></back>| Cloudflare R2 storage I/O |
  |<back:#AD1457><color:#FFFFFF> api </color></back>| External Dukascopy API call |
endlegend

start
:runTickParentHandler(ctx, "BACKFILL", dal);<<lock>>
note right
  Triggered by queue jobs.ticks.backfill (ideally every 10 minutes).
  Mutually exclusive with Ticks Regular — both share LockIDTick (1001),
  so only one mode can run at any given time.
  All three groups below require: Instrument.IsActive=true & IsPause=false.
end note

split
  ' ============== Group 1: Main Ingestion ==============
  :**Group 1 — Main Ingestion (resolve PENDING)**
  Claim: Status = PENDING;
  note right
    Typically rows generated by the
    Auto-Seeder, or rows freshly reset
    from an error state by Group 2.
  end note
  :Run the standard ETL cycle:
  Download raw BI5 (max 12 concurrent);<<api>>
  :Convert to Parquet (Decimal/BigInt);
  :Upload to Cloudflare R2;<<r2>>
  note right: Convert & Upload share the global\nBounded Semaphore (e.g. max 50) for OOM protection

  if (ETL Result?) then (Success)
    :Status -> COMPLETED;
  elseif () then (Source returns 404 / empty)
    :AddNotFoundStreak(+1) — atomic;
    if (NotFoundStreak >= 3 ?) then (yes)
      :Run Zero-Row safeguard procedure
      (DB IsHoliday=true first -> upload -> validate)
      -> Status CONFIRMED + SyncTask;<<db>>
    else (not yet)
      :Status -> NOT_FOUND;
    endif
  else (Handled error)
    :Status -> FAILED;
  endif

split again
  ' ============== Group 2: Reset & Recovery ==============
  :**Group 2 — Reset & Recovery ("housekeeping")**
  Claim: Status IN (PROCESSED, FAILED, BROKEN);
  note right
    No download/upload here — purely a
    state-cleanup pass ("cuci gudang").
    Any PROCESSED row reaching Backfill is
    GUARANTEED to be a zombie worker, so it is
    claimed immediately **without** checking UpdatedAt.
  end note

  if (Claimed row's status?) then (PROCESSED — zombie/stuck)
    :Reset directly -> PENDING
    (TICK: no RetryCount change);
  else (FAILED or BROKEN — corrupt/error)
    :AddRetryCount(+1) — atomic SQL increment;
    if (RetryCount >= 5 ?) then (yes)
      :Status -> ABANDONED
      (stop the endless retry queue,
      needs manual engineer review);
    else (no, still under the limit)
      :Status -> PENDING
      (Overwrite Policy: the next ingestion
      run MUST overwrite the existing R2 object);
    endif
  endif

split again
  ' ============== Group 3: Final Validation ==============
  :**Group 3 — Final Validation (evaluate COMPLETED & NOT_FOUND)**
  Claim: Status IN (COMPLETED, NOT_FOUND);
  note right
    COMPLETED here = rows the regular T-2 cycle
    hasn't promoted yet. NOT_FOUND here = evaluated
    WITHOUT any streak threshold, to guarantee
    nothing stays stuck.
  end note

  if (Claimed row's status?) then (COMPLETED)
    :Read the Parquet object from R2 and run
    the full **Physical Parquet Validation** (6.3);<<r2>>
    if (Validation passed?) then (yes)
      :Status -> CONFIRMED + insert SyncTask
      (same transaction);<<db>>
    else (corrupt / schema mismatch)
      :Status -> BROKEN
      (+ demotion SyncTask if PreviousStatus
      == CONFIRMED);<<db>>
    endif
  else (NOT_FOUND)
    :Re-check the Dukascopy source API;<<api>>
    note right
      **Rate-limiter rule:** MUST reuse the SAME
      Bounded Semaphore (max 12) as the BI5
      download path — otherwise bulk-checking
      hundreds of historical NOT_FOUND rows would
      trigger HTTP 429 storms against Dukascopy.
    end note
    if (Outcome of the re-check?) then (Data is now available & valid)
      :Download -> Convert -> Upload -> Validate;
      :Reset NotFoundStreak = 0 — atomic;
      :Status -> CONFIRMED + insert SyncTask;<<db>>
    elseif () then (Still empty: API returns 404)
      :AddNotFoundStreak(+1) — atomic;
      if (NotFoundStreak >= 3 ?) then (yes — permanent holiday)
        :**Strict ordered Zero-Row procedure**
        (prevents infinite loop on crash/race):
        1. Build Zero-Row Parquet in memory
        2. Commit DB IsHoliday=true FIRST
        3. ONLY THEN upload to R2
        4. Read back & physically validate (6.3)
        5. Status -> CONFIRMED (terminal) + SyncTask;<<db>>
      else (still within tolerance)
        :Status remains NOT_FOUND;
      endif
    else (File downloaded but corrupt)
      :Status -> BROKEN
      (+ demotion SyncTask if PreviousStatus
      == CONFIRMED — re-ingestion queued
      for the next Backfill cycle);<<db>>
    endif
  endif
end split

:wg.Done() x3 — join point
(Parent Handler releases LockIDTick
once all three groups complete);
stop

@enduml
