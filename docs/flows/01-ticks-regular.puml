@startuml 01-ticks-regular
title Geonera Ingestion — 1. Ticks Regular (T-0 / T-1 / T-2)
skinparam backgroundColor #FFFFFF
skinparam defaultFontColor #1B1B1B
skinparam ArrowColor #546E7A
skinparam ArrowFontColor #37474F

skinparam activity {
  BackgroundColor #FAFAFA
  BorderColor #546E7A
  FontColor #1B1B1B
  FontSize 13

  BackgroundColor<<lock>> #EF6C00
  FontColor<<lock>> #FFFFFF
  BorderColor<<lock>> #A34B00

  BackgroundColor<<db>> #1565C0
  FontColor<<db>> #FFFFFF
  BorderColor<<db>> #0B3C78

  BackgroundColor<<r2>> #2E7D32
  FontColor<<r2>> #FFFFFF
  BorderColor<<r2>> #1B5E20

  BackgroundColor<<api>> #AD1457
  FontColor<<api>> #FFFFFF
  BorderColor<<api>> #6A0F38
}

skinparam activityDiamond {
  BackgroundColor #FFF3CD
  BorderColor #C79100
  FontColor #5D4037
}

skinparam legend {
  BackgroundColor #FFFFFF
  BorderColor #90A4AE
  FontColor #1B1B1B
  FontSize 12
  EntrySeparatorColor #CFD8DC
}

skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #C9A227
  FontColor #3E3E3E
}

legend right
  |= Tag |= Meaning |
  |<back:#EF6C00><color:#FFFFFF> lock </color></back>| Advisory-lock / Parent Handler step |
  |<back:#1565C0><color:#FFFFFF> db </color></back>| PostgreSQL transaction (state / outbox) |
  |<back:#2E7D32><color:#FFFFFF> r2 </color></back>| Cloudflare R2 storage I/O |
  |<back:#AD1457><color:#FFFFFF> api </color></back>| External Dukascopy API call |
endlegend

start
:runTickParentHandler(ctx, "REGULAR", dal);<<lock>>
note right
  Triggered by queue jobs.ticks.regular,
  expected to fire every hour at minute :05 (e.g. 10:05 UTC).
  Runs only after LockIDTick (1001) is acquired
  via the Direct Connection (see 00-overview-and-locking.puml).
end note

split
  ' ===================== T-0 =====================
  :**T-0 — Current Hour (Real-time Ingestion)**
  Target timestamp = current running hour
  (e.g. run at 10:05 -> target 10:00:00 UTC);
  :Query all instruments WHERE IsActive=true AND IsPause=false;<<db>>
  :For each instrument: INSERT PENDING row at target
  using INSERT ... ON CONFLICT DO NOTHING;<<db>>
  note right
    Safety-net seed — guarantees every eligible
    instrument has a PENDING task for this hour
    even if the maintenance worker has not yet
    seeded it (brand-new or just reactivated).
    Rows that already exist are silently skipped.
  end note
  :Claim: JobType=TICK, Status=PENDING,
  Instrument.IsPause=false & IsActive=true
  (FOR UPDATE SKIP LOCKED via DAL.ExecuteInPool);
  :Update -> PROCESSED
  (SetPreviousStatus = old status, atomic);
  :Download raw BI5 file from Dukascopy API;<<api>>
  note right: Bounded Semaphore — hard cap **12** concurrent goroutines\n(primary defense against HTTP 429 Too Many Requests)

  if (Download result?) then (2xx — data received)
    :Reset NotFoundStreak = 0 (if non-zero);<<db>>
    :Convert BI5 integer format -> Parquet
    (Decimal/BigInt, using Instrument.Divider);
    note right: CPU-bound; semaphore capped at **runtime.NumCPU()**\n(saturates all cores without over-subscribing)
    :Upload the resulting Parquet file to
    Cloudflare R2 (ticks/{instrument}/{YYYY}/{MM}/...);<<r2>>
    note right: I/O-bound; shares the same NumCPU-slot semaphore\nas the convert step
    :Status -> COMPLETED;
  elseif () then (404 — no data at source)
    :SetNotFoundStreak = 1
    (T-0 PENDING rows are always freshly seeded —
    streak is guaranteed 0, so set to 1 is exact);<<db>>
    :Status -> NOT_FOUND;
    note right
      Zero-Row Parquet is NOT committed in T-0.
      T-1 uploads Zero-Row at streak=2 (no validation).
      T-2 validates the existing file at streak=3 → CONFIRMED.
    end note
  elseif () then (non-2xx / non-404 — system error)
    :Status -> FAILED;
  else (Unhandled panic / crash mid-flight)
    :Row stays PROCESSED (stuck);
    note right: Will be swept up later by\nT-1 (Regular) or Backfill Reset Group
  endif

split again
  ' ===================== T-1 =====================
  :**T-1 — Previous Hour (Recovery & Retry / Safety Net)**
  Target timestamp = one hour before current
  (e.g. run at 10:05 -> target 09:00:00 UTC);
  :Claim: Status IN (PENDING, PROCESSED, FAILED, **BROKEN**, NOT_FOUND),
  Instrument.IsPause=false & IsActive=true;
  note right
    "Claim" di sini berarti pengambilan task untuk diproses.
    PreviousStatus dicatat sebagai record status sebelum di-claim —
    bukan sebagai logic routing.
  end note

  if (Status sebelum di-claim?) then (PROCESSED — stuck/zombie worker)
    :Sweep & reset directly -> PENDING
    (no RetryCount change for TICK);
  elseif () then (PENDING)
    :Refresh / remains PENDING;
  elseif () then (FAILED or BROKEN)
    :AddRetryCount(+1), SetNotFoundStreak(-1 min 0) — atomic;<<db>>
    :Status -> PENDING;
    note right
      No ABANDONED cap — retry is unbounded
      for T-1 recovery. RetryCount keeps
      growing but never triggers ABANDONED.
    end note
  else (NOT_FOUND)
    :Download raw BI5 file from Dukascopy API;<<api>>
    note right: Rate gate + Semaphore (same throttle as T-0)
    if (Download result?) then (2xx — data now available)
      :SetNotFoundStreak = 0 — atomic;<<db>>
      :Status -> PENDING (re-attempt on next cycle);
    elseif () then (404 — still empty)
      :AddNotFoundStreak(+1) — streak: 1 → 2
      Set IsHoliday = true
      **DB commit BEFORE R2 upload**;<<db>>
      :Build Zero-Row Parquet in memory;
      :Upload Zero-Row Parquet to R2;<<r2>>
      :Status -> NOT_FOUND;
      note right
        No validation at T-1.
        T-2 re-downloads; at streak=3
        executeValidation (reads R2) → CONFIRMED.
      end note
    else (non-2xx / non-404 error)
      :Status -> FAILED;
    endif
  endif

split again
  ' ===================== T-2 =====================
  :**T-2 — Two Hours Ago (Cross-Validation & Promotion)**
  Target timestamp = two hours before current
  (e.g. run at 10:05 -> target 08:00:00 UTC);
  :Claim: Status IN (COMPLETED, NOT_FOUND),
  Instrument.IsActive = true;
  :Download raw BI5 file from Dukascopy API;<<api>>
  note right: Rate gate + Semaphore (same throttle as T-0)

  if (Claimed status + Download result?) then (COMPLETED + 2xx)
    note right: Re-download matches T-0 source — cross-validation
    :Reset NotFoundStreak = 0 (if non-zero);<<db>>
    :Convert BI5 → Parquet;
    :Upload (overwrite) to Cloudflare R2;<<r2>>
    :Run **Physical Parquet Validation** (criteria 6.3):
    - File existence & size > 0
    - Magic number PAR1 + footer integrity
    - Schema matching (columns, types, precision)
    - Data continuity & 1-hour boundary check;
    if (Validation result?) then (PASSED)
      :Status -> CONFIRMED;
      :Insert SyncTask (outbox) in same transaction;<<db>>
    else (FAILED)
      :Status -> BROKEN;
    endif
  elseif () then (NOT_FOUND + 2xx — data now available)
    :SetNotFoundStreak = 0 — atomic;<<db>>
    :Status -> PENDING (re-attempt on next cycle);
  elseif () then (NOT_FOUND + 404 — still empty)
    :AddNotFoundStreak(+1), RetryCount(-1 min 0) — atomic;<<db>>
    if (NotFoundStreak >= 3 ?) then (yes — confirmed holiday)
      note right
        Zero-Row Parquet already in R2 from T-1.
        Validate the existing file — no re-upload needed.
      end note
      :Read Zero-Row Parquet from Cloudflare R2;<<r2>>
      :Run **Physical Parquet Validation** (criteria 6.3):
      - File existence & size > 0
      - Magic number PAR1 + footer integrity
      - Schema matching (columns, types, precision)
      - Zero-row boundary check (IsHoliday=true);
      if (Validation result?) then (PASSED)
        :Status -> CONFIRMED;
        :Insert SyncTask (outbox) in same transaction;<<db>>
      else (FAILED)
        :Status -> BROKEN;
      endif
    else (streak < 3)
      :Status -> NOT_FOUND;
    endif
  elseif () then (COMPLETED + 404 — anomaly)
    :Status -> BROKEN;
    note right: Data was present at T-0 but\nis now missing — investigate manually
  else (non-2xx / non-404 error)
    :Status -> FAILED;
  endif
end split

:wg.Done() x3 — join point
(Parent Handler's wg.Wait() can now
proceed to release the advisory lock);
stop

@enduml
