# Version control
.git/
.gitignore

# Environment files — NEVER bake credentials into the image
.env
.env.*

# Docker files (not needed inside the image)
docker-compose*.yml
Dockerfile
.dockerignore

# Documentation
*.md
docs/

# Root-level init.sql is only for the PostgreSQL Docker container — not for the app.
# The leading / ensures only the root file is excluded, NOT database/init.sql
# which is read by EnsureSchema() at startup to bootstrap the DB schema.
/init.sql

# Editor / IDE artifacts
.vscode/
.idea/
*.swp
*.swo

# OS artifacts
.DS_Store
Thumbs.db

# Go build artifacts that might exist locally
geonera-ingestion
geonera-ingestion.exe
